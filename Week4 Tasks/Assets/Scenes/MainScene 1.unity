  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPC
  dialoguePanel: {fileID: 1802896310}
  dialogueText: {fileID: 1774272492}
  dialogue:
  - 'Hello! Warrior what a bad day to be alive '
  - It has been 100 years since we had been invaded this is  worst
  - 'We are counting on you and i have heard that the door is locked outside '
  - 'And the key is kept somewhere in forest '
  - Finding the remaining three keys  will be diifucult
  - You have find three apples for that key
  - 'The keys have changed thier form in apple and hidden '
  - 'Find the three apples and yours keys will be in hand '
  - 'The apples mostly will be in lake sides '
  - The enemy also have the power to expand his body be careful
  - 'Find it and save the village '
  wordSpeed: 0.01
  playerIsClose: 0
